{
  "name": "@newbrush/vite",
  "version": "0.0.0",
  "description": "Vite plugin for newBrush: on-demand utilities with fast HMR.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newsignlabs/css-project",
    "directory": "packages/vite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@newbrush/engine": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "newbrush": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
