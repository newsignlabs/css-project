{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "0ms"
      },
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      },
      "slower": {
        "$value": "500ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "emphasized": {
        "$value": [0.3, 0, 0, 1]
      },
      "decelerate": {
        "$value": [0, 0, 0, 1]
      },
      "accelerate": {
        "$value": [0.3, 0, 1, 1]
      }
    }
  }
}
