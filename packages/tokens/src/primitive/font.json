{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Noto Sans",
          "Arial",
          "sans-serif",
          "Apple Color Emoji",
          "Segoe UI Emoji"
        ],
        "$description": "System UI stack (zero download, FR-022)"
      },
      "serif": {
        "$value": [
          "ui-serif",
          "Charter",
          "Bitstream Charter",
          "Sitka Text",
          "Cambria",
          "Georgia",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "SF Mono",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid type scale (Utopia, 360→1280px viewport, ratio 1.2→1.25)",
      "xs": {
        "$value": "clamp(0.6944rem, 0.6844rem + 0.0444vi, 0.72rem)"
      },
      "sm": {
        "$value": "clamp(0.8333rem, 0.8072rem + 0.1159vi, 0.9rem)"
      },
      "base": {
        "$value": "clamp(1rem, 0.9511rem + 0.2174vi, 1.125rem)"
      },
      "lg": {
        "$value": "clamp(1.2rem, 1.1193rem + 0.3587vi, 1.4063rem)"
      },
      "xl": {
        "$value": "clamp(1.44rem, 1.3156rem + 0.5527vi, 1.7578rem)"
      },
      "2xl": {
        "$value": "clamp(1.728rem, 1.5444rem + 0.8161vi, 2.1973rem)"
      },
      "3xl": {
        "$value": "clamp(2.0736rem, 1.8103rem + 1.1704vi, 2.7466rem)"
      },
      "4xl": {
        "$value": "clamp(2.4883rem, 2.1186rem + 1.6433vi, 3.4332rem)"
      },
      "5xl": {
        "$value": "clamp(2.986rem, 2.4751rem + 2.2705vi, 4.2915rem)"
      },
      "6xl": {
        "$value": "clamp(3.5832rem, 2.8862rem + 3.0978vi, 5.3644rem)"
      }
    },
    "leading": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.15
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.55
      },
      "relaxed": {
        "$value": 1.75
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.04em"
      }
    }
  }
}
