{
  "color": {
    "$type": "color",
    "neutral": {
      "$description": "Cool gray used for surfaces, text and borders",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.016 260)",
          "kind": "neutral"
        }
      }
    },
    "brand": {
      "$description": "Primary brand hue; replaced by theme.seeds.brand",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.19 255)",
          "kind": "chromatic"
        }
      }
    },
    "accent": {
      "$description": "Secondary accent hue",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.2 320)",
          "kind": "chromatic"
        }
      }
    },
    "success": {
      "$description": "Positive outcomes",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.15 150)",
          "kind": "chromatic"
        }
      }
    },
    "warning": {
      "$description": "Caution states",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.16 75)",
          "kind": "chromatic"
        }
      }
    },
    "danger": {
      "$description": "Destructive and error states",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.2 25)",
          "kind": "chromatic"
        }
      }
    },
    "info": {
      "$description": "Informational states",
      "$extensions": {
        "nb.seed": {
          "color": "oklch(62.4% 0.13 230)",
          "kind": "chromatic"
        }
      }
    },
    "white": {
      "$value": "oklch(100% 0 0)"
    },
    "black": {
      "$value": "oklch(0% 0 0)"
    }
  }
}
