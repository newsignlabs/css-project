{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferredScheme": {
      "default": "auto",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "density": {
      "default": "default",
      "type": "string",
      "enum": [
        "compact",
        "default",
        "airy",
        "grid-4"
      ]
    },
    "fonts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "default": {},
      "description": "DTCG overrides applied in every scheme",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "schemes": {
      "default": {},
      "description": "Extra overrides for one scheme only",
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "dark": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "description"
        ]
      }
    },
    "a11y": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "default": "beta",
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "deprecated"
      ]
    },
    "since": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    }
  },
  "required": [
    "name",
    "title",
    "description",
    "since"
  ],
  "additionalProperties": false,
  "$id": "https://newbrush.dev/schema/style-source.v1.json"
}
