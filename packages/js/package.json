{
  "name": "@newbrush/js",
  "version": "0.0.0",
  "description": "Optional newBrush behaviours: switch design styles at runtime (setStyle/getStyle), with View Transitions and persistence.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newsignlabs/css-project",
    "directory": "packages/js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "size": "size-limit"
  },
  "devDependencies": {
    "@newbrush/styles": "workspace:*",
    "@size-limit/file": "^12.1.0",
    "happy-dom": "^20.0.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "size-limit": [
    {
      "name": "@newbrush/js (all behaviours, constitution §VI)",
      "path": "dist/index.js",
      "limit": "6 kB",
      "brotli": true
    }
  ]
}
