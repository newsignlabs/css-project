{
  "name": "@newbrush/fonts",
  "version": "0.0.0",
  "description": "Opt-in self-hostable variable fonts for newBrush (Inter, Fraunces, JetBrains Mono): subsetted WOFF2, font-display swap, wired to the font.family tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newsignlabs/css-project",
    "directory": "packages/fonts"
  },
  "exports": {
    ".": "./dist/fonts.css",
    "./fonts.css": "./dist/fonts.css",
    "./*.css": "./dist/*.css",
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json"
  },
  "style": "./dist/fonts.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.4.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@newbrush/tokens": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
