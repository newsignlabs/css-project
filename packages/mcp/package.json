{
  "name": "@newbrush/mcp",
  "version": "0.0.0",
  "description": "newBrush MCP server: tools that let AI agents generate newBrush CSS and explain its classes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newsignlabs/css-project",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "css",
    "newbrush",
    "ai"
  ],
  "bin": {
    "newbrush-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@newbrush/engine": "workspace:*",
    "@newbrush/tokens": "workspace:*",
    "culori": "^4.0.2",
    "minisearch": "^7.2.0",
    "parse5": "^8.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@newbrush/schema": "workspace:*",
    "@types/culori": "^4.0.1",
    "fast-check": "^4.10.2",
    "html-validate": "^11.22.1",
    "newbrush": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
