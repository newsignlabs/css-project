---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { groupBy, manifest, slug, titleCase } from "../../lib/manifest.ts";

const groups = groupBy(manifest.components, (c) => c.category);
---

<StarlightPage
  frontmatter={{
    title: "Components",
    description: `All ${manifest.components.length} newBrush components, from layout primitives to overlays.`,
    editUrl: false,
  }}
  headings={groups.map(([category]) => ({ depth: 2, slug: slug(category), text: titleCase(category) }))}
>
  <p>
    Every component is a plain class on semantic HTML: <code>.nb-btn</code>, <code>.nb-card</code>… Modifiers use
    <code>--name</code>, parts use <code>__part</code>. Each page lists anatomy, modifiers, accessibility needs and
    the tokens to override.
  </p>
  {
    groups.map(([category, items]) => (
      <>
        <h2 id={slug(category)}>{titleCase(category)}</h2>
        <ul>
          {items.map((c) => (
            <li><a href={`/components/${c.name}/`}>{c.title}</a> — {c.description}</li>
          ))}
        </ul>
      </>
    ))
  }
</StarlightPage>
