---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { manifest, slug } from "../../lib/manifest.ts";

// specs/001 T081 — the design styles from the manifest (full style pages come with specs/004 T035).
---

<StarlightPage
  frontmatter={{
    title: "Design styles",
    description: "One class re-skins every component: the built-in newBrush design styles.",
    editUrl: false,
  }}
  headings={manifest.styles.map((s) => ({ depth: 2, slug: slug(s.name), text: s.title }))}
>
  <p>
    Put a style class on <code>&lt;body&gt;</code> (or any element, as an island) and every component inside takes
    that look: <code>class="neon"</code>, <code>class="nb-neon"</code> or <code>data-nb-style="neon"</code>.
    <code>class="style-default"</code> resets a subtree. Styles compose with the light, dark and contrast themes.
  </p>
  {
    manifest.styles.map((s) => (
      <section data-style={s.name}>
        <h2 id={slug(s.name)}>{s.title}</h2>
        <p>{s.description}</p>
        <ul>
          <li>Classes: <code>.{s.name}</code>, <code>.nb-{s.name}</code>{s.aliases.map((a) => <>, <code>.{a}</code></>)}</li>
          <li>Preferred scheme: {s.preferredScheme} · density: {s.density}</li>
          {s.effects.length > 0 && <li>Effects: {s.effects.join(", ")}</li>}
          {s.fonts.length > 0 && <li>Fonts (opt-in): {s.fonts.join(", ")}</li>}
          <li>Token overrides: {s.tokens.length}</li>
        </ul>
        <div class={`nb-docs-preview not-content ${s.name}`}>
          <div class="nb-cluster">
            <button class="nb-btn nb-btn--primary" type="button">Primary</button>
            <button class="nb-btn" type="button">Secondary</button>
            <span class="nb-badge">Badge</span>
          </div>
        </div>
      </section>
    ))
  }
</StarlightPage>
